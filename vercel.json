{
  "version": 2,
  "builds": [
    { "src": "backend/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.js" },
    { "src": "/static/(.*)", "dest": "/client/static/$1" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
